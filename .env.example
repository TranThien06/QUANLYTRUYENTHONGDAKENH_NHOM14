APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_media_mgmt_aligned
# Generated by: python -m scripts.setup. Keep the old key when migrating from Express.
TOKEN_ENCRYPTION_KEY=
STORAGE_DIR=storage
MAX_UPLOAD_MB=50
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
# file: lưu email demo. Đổi smtp sau khi điền tài khoản Gmail và Mật khẩu ứng dụng.
MAIL_MODE=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail gửi thư (bật xác minh 2 bước và tạo Mật khẩu ứng dụng)
SMTP_USER=
SMTP_PASSWORD=
# Đặt cùng địa chỉ Gmail trong SMTP_USER
MAIL_FROM=
# mock supports local tests only; server refuses mock in production
SOCIAL_MODE=mock
SOCIAL_OAUTH_PLATFORMS=facebook,instagram,tiktok
SOCIAL_OAUTH_REQUIRE_LIVE=false
# Chỉ kết nối và đọc Trang trong đợt thử nghiệm Facebook:
# FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# Font .ttf supporting Vietnamese, required for Vietnamese PDF exports
REPORT_FONT_PATH=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_EXTRA_SCOPES=
